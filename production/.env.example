# Copy to .env and replace every value before deploying.

# Database
POSTGRES_USER=stream
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=stream_db

# LiveKit (must match livekit.yaml and egress.yaml)
LIVEKIT_URL=http://livekit:7880
LIVEKIT_API_KEY=replace-with-api-key
LIVEKIT_API_SECRET=replace-with-api-secret-of-at-least-32-chars

# Backend
JWT_SECRET=replace-with-a-long-random-string

# Frontend is configured via docker-compose build args and environment variables directly
# because they need to be baked in or injected at runtime (Next.js public envs).
